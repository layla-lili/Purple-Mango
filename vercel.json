{
  "version": 2,
  "functions": {
    "api/actions/*.ts": {
      "runtime": "vercel-node@latest"
    }
  },
  "rewrites": [
    { "source": "/actions.json", "destination": "/actions.json" },
    { "source": "/api/actions/:path*", "destination": "/api/actions/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}